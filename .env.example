# Copy to .env and `set -a; source .env; set +a` before running the scripts.

# kubeconfig context of the EKS cluster (deploy/deploy.sh, harness/run-matrix.sh,
# sandboxmanager/deploy-eks.sh)
KUBE_CONTEXT=

# Region of the cluster and its ECR registry (deploy/build-images.sh, sandboxmanager/deploy-eks.sh)
AWS_REGION=

# Optional: image registry; defaults to <account>.dkr.ecr.<region>.amazonaws.com
REGISTRY=

# S3 bucket for SandboxManager's workspace snapshots (sandboxmanager/deploy-eks.sh)
SNAPSHOT_BUCKET=
